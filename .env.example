# --- Existant
OPENAI_API_KEY=sk-...
DATABASE_URL=                      # vide = SQLite local (data.db) ; sur Render mettre une URL postgres:// (sinon les données sont perdues à chaque déploiement)
SUPABASE_URL=                      # copie durable des photos de dépôts (Render n'a pas de disque persistant en offre gratuite)
SUPABASE_SERVICE_ROLE=
SUPABASE_BUCKET=generated

# --- Module dépôts d'espèces (/depots pour la responsable, /caisse pour le gérant)
# Le dépôt est public : ne jamais écrire de vrais codes ou secrets dans ce fichier ni dans le code.
# Comptes : de préférence en base via PUT /cash/admin/users (codes hachés). Sinon, variable d'env :
# identifiant:code:role[:libellé], séparés par des virgules. role = owner (gérant) ou manager (responsable).
CASH_USERS=
CASH_SECRET=                       # facultatif : sinon un secret aléatoire est créé et gardé en base
CASH_ADMIN_TOKEN=                  # facultatif : sinon seul le jeton dont l'empreinte est dans config.json est accepté

# Lecture des photos.
# deferred (défaut) : les photos sont stockées, puis lues par une tâche Claude planifiée sur l'abonnement
#   claude.ai du gérant (aucune clé API). La tâche s'authentifie avec un jeton dérivé de CASH_SECRET
#   (ou CASH_WORKER_TOKEN s'il est défini).
# immediate : lecture à l'envoi via l'API, avec écran de vérification pour la responsable (clé API payante).
CASH_ANALYSIS_MODE=deferred
CASH_ANALYSIS_TIMES=12:05,18:05    # heures de passage affichées à la responsable (heure de Paris)
CASH_WORKER_TOKEN=                 # facultatif
ANTHROPIC_API_KEY=                 # mode immediate uniquement
CASH_VISION_PROVIDER=anthropic     # mode immediate : anthropic ou openai (alors OPENAI_API_KEY + gpt-4o)
CASH_VISION_MODEL=claude-opus-5-5
CASH_MOCK_EXTRACTION=0             # 1 = mode simulé (fichiers JSON à la place des photos), pour les tests
CASH_SCHEDULER=1                   # 0 = pas de contrôles automatiques en tâche de fond (utiliser alors un cron sur POST /cash/checks/run)
CASH_CHECKS_INTERVAL_SECONDS=900
CASH_PUBLIC_URL=https://mon-site.example.com   # pour les liens dans les e-mails

# Alertes e-mail (SMTP). Avec Gmail : smtp.gmail.com, port 587, mot de passe d'application.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CASH_ALERT_EMAIL_TO=anthony@example.com

# Google Sheets "Comptage coffre" (lecture seule) : compte de service Google.
# Contenu JSON du compte de service, ou chemin vers le fichier .json. Partager chaque sheet avec l'e-mail du compte de service.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Rapprochement bancaire Pennylane (API v2), une clé par société.
PENNYLANE_API_KEY_AEJB=
PENNYLANE_API_KEY_JAB=
