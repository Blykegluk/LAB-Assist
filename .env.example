# --- Existant
OPENAI_API_KEY=sk-...
DATABASE_URL=                      # vide = SQLite local (data.db) ; sinon postgres://...

# --- Module dépôts d'espèces (/depots pour la responsable, /caisse pour le gérant)
CASH_MANAGER_PIN=1234              # code de la responsable (à changer !)
CASH_OWNER_PASSWORD=admin          # mot de passe du gérant (à changer !)
CASH_SECRET=                       # secret de signature des jetons (long et aléatoire)
CASH_VISION_MODEL=gpt-4o           # modèle vision pour lire les photos (gpt-4o recommandé pour l'écriture manuscrite)
CASH_MOCK_EXTRACTION=0             # 1 = mode simulé (fichiers JSON à la place des photos), pour les tests
CASH_SCHEDULER=1                   # 0 = pas de contrôles automatiques en tâche de fond (utiliser alors un cron sur POST /cash/checks/run)
CASH_CHECKS_INTERVAL_SECONDS=900
CASH_PUBLIC_URL=https://mon-site.example.com   # pour les liens dans les e-mails

# Alertes e-mail (SMTP). Avec Gmail : smtp.gmail.com, port 587, mot de passe d'application.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CASH_ALERT_EMAIL_TO=anthony@example.com

# Google Sheets "Comptage coffre" (lecture seule) : compte de service Google.
# Contenu JSON du compte de service, ou chemin vers le fichier .json. Partager chaque sheet avec l'e-mail du compte de service.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Rapprochement bancaire Pennylane (API v2), une clé par société.
PENNYLANE_API_KEY_AEJB=
PENNYLANE_API_KEY_JAB=
